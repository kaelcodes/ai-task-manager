{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "keyring:default",
    "keyring:allow-get-password",
    "keyring:allow-set-password",
    "keyring:allow-delete-password",
    "notification:default"
  ]
}
